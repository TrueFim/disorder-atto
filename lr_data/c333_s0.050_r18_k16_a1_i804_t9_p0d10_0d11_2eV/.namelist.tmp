
&calculation
theory = 'tddft_response'
/

&control
sysname = 'lr'

yn_self_checkpoint = 'y'

checkpoint_interval = 29999
/

&units
unit_system = 'A_eV_fs'
/

&parallel
yn_ffte = 'y'

nproc_ob=4
nproc_rgrid=3,2,3
nproc_k=125
/

&system
yn_periodic = 'y'

al(1:3) = 16.29d0, 16.29d0, 16.29d0

nelem  = 1
natom  = 216
nelec  = 864
nstate = 864
/

&pseudo
file_pseudo(1) = './Si_rps.dat'

izatom(1) = 14

lloc_ps(1) = 2
/

&functional
xc = 'PZ'
/

&rgrid
num_rgrid(1:3) = 54, 54, 54
/

&kgrid
num_kgrid(1:3) = 5, 5, 5
/

&tgrid
dt = 0.002d0
nt = 30000
/

&emfield
ae_shape1 = 'impulse'

epdir_re1(1:3) = 0.00d0, 0.00d0, 1.00d0
/

&analysis
de      = 0.01d0
nenergy = 1200
/

