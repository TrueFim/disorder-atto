
&calculation
theory = 'tddft_pulse'
/

&control
sysname = 'pump_pulse'
/

&units
unit_system = 'A_eV_fs'
/

&parallel
yn_ffte = 'y'


nproc_ob=1
nproc_rgrid=1,1,1
nproc_k=16
/

&system
yn_periodic = 'y'

al(1:3) = 5.43d0, 5.43d0, 5.43d0

nelem  = 1
natom  = 8
nelec  = 32
nstate = 32
/

&pseudo
file_pseudo(1) = './Si_rps.dat'

izatom(1) = 14

lloc_ps(1) = 2
/

&functional
xc = 'PZ'
/

&rgrid
num_rgrid(1:3) = 18, 18, 18
/

&kgrid
num_kgrid(1:3) = 18, 18, 18
/

&tgrid
dt = 0.002d0
nt = 15000
/


&emfield
ae_shape1 = 'Acos2'
I_wcm2_1 = 0d9
tw1 = 21d0
omega1 = 0.1d0
epdir_re1(1:3) = 1.0d0, 0.0d0, 0.0d0
phi_cep1 = 0.25


ae_shape2 = 'Acos4'
I_wcm2_2 = 6d11
tw2 = 4.35d0
omega2 = 2d0
epdir_re2(1:3) = 0.0d0, 0.0d0, 1.0d0

t1_t2 = 0d0


/

&analysis
de      = 0.01d0
nenergy = 3000

projection_option = 'td'
out_projection_step = 16000
/

