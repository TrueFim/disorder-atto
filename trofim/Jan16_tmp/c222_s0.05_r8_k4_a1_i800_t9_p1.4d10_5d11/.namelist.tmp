
&calculation
theory = 'dft'
/

&control
sysname = 'gs'
/

&units
unit_system = 'A_eV_fs'
/

&parallel
yn_ffte = 'y'


nproc_ob=1
nproc_rgrid=1,1,1
nproc_k=64
/

&system
yn_periodic = 'y'

al(1:3) = 10.86d0, 10.86d0, 10.86d0

nelem  = 1
natom  = 64
nelec  = 256
nstate = 256
/

&pseudo
file_pseudo(1) = './Si_rps.dat'

izatom(1) = 14

lloc_ps(1) = 2
/

&functional
xc = 'PZ'
/

&rgrid
num_rgrid(1:3) = 16, 16, 16
/

&kgrid
num_kgrid(1:3) = 2, 2, 2
/

&scf
nscf      = 800
threshold = 1.0d-9
/

